{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atesto.dev/schemas/proof.schema.json",
  "title": "Atesto proof",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "head",
    "tree_sha256",
    "dirty",
    "dirty_paths",
    "command",
    "exit",
    "output"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "enum": ["command"] },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[.+-]?[0-9A-Za-z]+(?:[.+-][0-9A-Za-z]+)*)?$" }
      }
    },
    "head": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dirty": { "type": "boolean" },
    "dirty_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "exit": { "type": "integer" },
    "output": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "truncated": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": true
}
