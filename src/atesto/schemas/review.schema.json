{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atesto.dev/schemas/review.schema.json",
  "title": "Atesto review",
  "type": "object",
  "required": [
    "schema",
    "head",
    "tree_sha256",
    "intent",
    "verdict",
    "reviewers",
    "findings"
  ],
  "properties": {
    "schema": { "const": 1 },
    "head": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "intent": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["APPROVED", "CHANGES_REQUESTED"] },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": { "type": "array" }
  },
  "additionalProperties": true
}
